{
  "apiVersion": 1,
  "id": "eidos.markdown-title-sync",
  "name": "%plugin.name%",
  "description": "%plugin.description%",
  "version": "0.2.0",
  "requires": {
    "pluginApi": "3.7.0"
  },
  "extension": "./src/extension.ts",
  "hooks": [
    {
      "id": "title-saved",
      "title": "%hooks.title-saved.title%",
      "event": "document.saved",
      "extensions": [
        ".md",
        ".markdown"
      ],
      "access": "write"
    },
    {
      "id": "file-renamed",
      "title": "%hooks.file-renamed.title%",
      "event": "file.renamed",
      "extensions": [
        ".md",
        ".markdown"
      ],
      "access": "write"
    }
  ],
  "settings": {
    "update-filename": {
      "type": "boolean",
      "title": "%settings.update-filename.title%",
      "default": true
    },
    "update-title": {
      "type": "boolean",
      "title": "%settings.update-title.title%",
      "default": true
    }
  },
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
